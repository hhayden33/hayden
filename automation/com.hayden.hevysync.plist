<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hayden.hevysync</string>
    <!-- Points at ~/.garmin-dashboard-automation, not this repo's own
         automation/ under ~/Desktop — launchd-spawned processes can't
         read anything under ~/Desktop (~/Documents, ~/Downloads too),
         confirmed by direct test; see install.sh's header comment.
         Deploy there (and reload this job) after editing hevy-sync.mjs
         or run-hevy-sync.sh: automation/install.sh && see README below. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/hh.ayden/.garmin-dashboard-automation/run-hevy-sync.sh</string>
    </array>
    <!-- Workouts happen at unpredictable times of day (unlike Garmin's
         overnight-synced sleep/activity data), so this runs on a plain
         interval rather than fixed morning/night times — every 30
         minutes, so a workout shows up on the dashboard soon after
         it's logged in Hevy without polling constantly. -->
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>StandardOutPath</key>
    <string>/Users/hh.ayden/.garmin-dashboard-automation/logs/launchd-hevy.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/hh.ayden/.garmin-dashboard-automation/logs/launchd-hevy.err.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
